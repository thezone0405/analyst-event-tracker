{
  "permissions": {
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-specs.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "npm test --silent -- run || (echo '❌ Stop Blocked: Unit tests are failing. Fix failing tests before finishing your turn.' >&2 && exit 2)"
          }
        ]
      }
    ]
  }
}
