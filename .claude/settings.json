{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npx jest *)",
      "Bash(npx crap4ts *)",
      "Bash(npx stryker *)",
      "Bash(npx tsc *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-specs.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "npx jest --silent || (echo '❌ Stop Blocked: Unit tests are failing. Fix failing tests before finishing your turn.' >&2 && exit 2)"
          }
        ]
      }
    ]
  }
}
